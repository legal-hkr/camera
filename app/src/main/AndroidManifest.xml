<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Privacy: only what the app needs. The camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Sound in videos (asked on the first entry into Video) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The place in photos and videos, asked for when turned on; the coarse one is declared next to the fine one (Android 12+), the user may allow only it -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <application
        android:name=".CameraApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Camera">

        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode|density|fontScale|fontWeightAdjustment|screenLayout|screenSize|smallestScreenSize|orientation|keyboard|keyboardHidden|navigation|colorMode|assetsPaths"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <!-- configChanges: a theme, font or wallpaper change mustn't recreate the viewfinder and end a recording or a countdown; Compose follows them itself.
                 The language still recreates the activity (its strings). Portrait only (family rule): the layout has no landscape arrangement. Android 16+
                 ignores it only on large screens (smallest width 600 dp and up), not on phones. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The system camera (SPEC §15.1): opened in Photo or Video -->
            <intent-filter>
                <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.VIDEO_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Selfie, Video, QR code (SPEC §15.5) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Over the lock screen (the power button pressed twice, SPEC §15.2): an activity of its own, out of the recent apps, so Settings never show there -->
        <activity
            android:name=".SecureCameraActivity"
            android:configChanges="uiMode|density|fontScale|fontWeightAdjustment|screenLayout|screenSize|smallestScreenSize|orientation|keyboard|keyboardHidden|navigation|colorMode|assetsPaths"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.secure"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.media.action.STILL_IMAGE_CAMERA_SECURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- A photo or a video for another app (SPEC §15.3); the secure one shows over the lock screen -->
        <activity
            android:name=".CaptureActivity"
            android:configChanges="uiMode|density|fontScale|fontWeightAdjustment|screenLayout|screenSize|smallestScreenSize|orientation|keyboard|keyboardHidden|navigation|colorMode|assetsPaths"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.media.action.IMAGE_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.IMAGE_CAPTURE_SECURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.VIDEO_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- A QR code's business card handed to the contacts app as a vCard file (cache/share only) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
